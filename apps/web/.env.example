# Database
# SQLite for local development
DATABASE_URL="file:./dev.db"

# PostgreSQL for production (Docker)
# DATABASE_URL="postgresql://clinic:your-password@localhost:5432/clinic_mvp"

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET="your-secure-random-secret-at-least-32-chars-long-here"

# Session / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# Email (for password reset)
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT=587
# SMTP_USER="your-email@domain.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@your-domain.com"

# Data Retention (days) — for automated cleanup
# Default: 365 (1 year)
# DATA_RETENTION_DAYS=365

# Face Verification
FACE_SERVICE_URL=http://face:8000
FACE_THRESHOLD=0.45
FACE_MODE=shadow
NEXT_PUBLIC_FACE_MODE=shadow

# GPS Location Verification (shadow mode)
# Default radius in metres when clinic.geoRadius is not set
GEO_DEFAULT_RADIUS=200

# Apricot Integration
# APRICOT_ENC_KEY must be a 32-byte base64 string (AES-256-GCM)
APRICOT_ENC_KEY="your-32-byte-base64-encryption-key-here=="
# APRICOT_CRON_KEY: secret key for cron-triggered sync (POST /api/apricot/sync/cron)
APRICOT_CRON_KEY="your-cron-key-change-in-production"
# Apricot booking write（MD v2.0 §2–§5）— fail-closed：默認 0
# APRICOT_WRITE: 1 = 開 /v1/bookings 寫入（create/status/remove/reschedule）；0 = 503 WRITE_DISABLED
APRICOT_WRITE=0
# ALLOW_NEW_PATIENT_WRITE: 1 = 允許新客開檔（inline patient）；0 = 422 NEW_PATIENT_DISABLED（第一階段只舊客）
ALLOW_NEW_PATIENT_WRITE=0

# Patient Read 鏈（read-chain MD §2.3）：phoneNum 只准 HMAC hash 形式落地
# PHONE_HASH_KEY: 32-byte random（openssl rand -hex 32）
# ★ 同 wa-clinic-inbox 用【同一條】key（兩 repo normalize/hash 要對得上先 match 到），
#   同 external key 一齊交收；唔設 = sync 行到 phoneHash 會 throw（fail-closed）
PHONE_HASH_KEY=

# ★ cwi-final S2-9：報價第二層經 wa-inbox proxy（應用層加密）
# 生產 server 值：WA_INBOX_LLM_URL=https://<APP_HOST>/api/internal/llm-extract（wa-inbox 公開網址；Cloudflare 只見到密文）
# INTERNAL_LLM_SECRET 必須同 wa-inbox 側同一條 key（base64、>=32 bytes；生產 = openssl rand -base64 48）
# ★ 唔好設 LLM_*（舊直連 client 已退役；生產 .env 清理 = 部署後 nightly 步驟，spec 次序 ④）
WA_INBOX_LLM_URL=
INTERNAL_LLM_SECRET=
INTERNAL_LLM_KID=k1
