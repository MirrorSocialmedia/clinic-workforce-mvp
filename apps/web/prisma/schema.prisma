// Clinic Workforce MVP — Prisma Schema
// Supports PostgreSQL (production) and SQLite (dev fallback)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  EMPLOYEE
  KIOSK
}

enum UserStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  PROBATION
}

enum PayType {
  MONTHLY
  DAILY
  HOURLY
  SPLIT
}

enum ShiftStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PunchType {
  CLOCK_IN
  CLOCK_OUT
  LUNCH_START
  LUNCH_END
}

enum PunchSource {
  QR_DYNAMIC
  QR_STATIC
  MANUAL_CORRECTION
  SYSTEM
}

// Shift change request types
enum ChangeType {
  SWAP
  COVER
  REPORT
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// Punch correction status
enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Leave request status
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Company entity — parent of clinics
model Company {
  id        String   @id @default(cuid())
  name      String
  logoData  String?  // data URL (image/png;base64,...)
  createdAt DateTime @default(now())

  clinics       Clinic[]
  shiftTemplates ShiftTemplate[]
  scheduleNotes  ScheduleNote[]
  schedulingMemos SchedulingMemo[]
  providers      Provider[]
}

// ★ 2026-08-04: 排班每日備註 —— 按公司，每日一條（上限 20 字）
model ScheduleNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  date      String   // ★ HK date string YYYY-MM-DD, not DateTime
  row       Int      @default(0)   // 0 = 表頭原有嗰行；1-5 = 底部五行
  text      String   // max 20 chars
  createdBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, date, row])
  @@index([companyId, date])
}

// ★ 2026-08-21: 排班頁月備註（純文字，冇任何下游影響）
// ⚠️ 只做記事 —— 唔入計糧／唔入 audit／唔影響任何計算
model SchedulingMemo {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth String   // 'YYYY-MM'（HK）
  text        String
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([companyId, periodMonth])
}

// Clinic entity
model Clinic {
  id        String   @id @default(cuid())
  name      String
  shortName String?  // 店鋪簡稱（1-2字：旺/仁/銅/荃/元/沙）
  color     String?  // 更表膠囊顏色 #RRGGBB，null = 灰色預設
  address   String?
  latitude  Float?   // 店舖緯度
  longitude Float?   // 店舖經度
  geoRadius Int?     // 允許半徑(米),null = 用全局預設 200
  apricotClinicId String? @unique // ★ Apricot 嘅 clinicId
  config    String?  // JSON string for SQLite compat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  users     UserClinic[]
  employees EmployeeClinic[]
  shifts    Shift[]
  punches   PunchRecord[]
  qrTokens  QRToken[]
  dailyHashes DailyHash[]
  payrollRuns     PayrollRun[]
  expenseEntries  ExpenseEntry[]
  homeEmployees   Employee[] @relation("HomeClinic")
  providerShifts  ProviderShift[]
  providerClinics ProviderClinic[]
  availabilities  ProviderAvailability[]
  bookings        ProviderBooking[]
}

// User entity — system login account
model User {
  id        String       @id @default(cuid())
  name      String
  /// 身份證全名 —— 純記錄用，會喺薪資明細顯示。唔用於登入或搜尋。
  fullName  String?
  phone     String       @unique
  email     String?
  password  String       // bcrypt hash
  role      UserRole     @default(EMPLOYEE)
  status    UserStatus   @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  clinics   UserClinic[]
  employee  Employee?
  auditLogs       AuditLog[]   @relation("ActorLogs")
  resetToken      String?
  resetTokenExpiry DateTime?
  permissionsJson String? // JSON: { "grant": [...], "deny": [...] }
  tokenVersion   Int      @default(0)
  ipAllowlist    String?  // comma-separated IPs or prefixes (KIOSK only)

  @@index([role])
  @@index([status])
  @@index([phone])
}

// Join table: User ↔ Clinic (access scope)
model UserClinic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
}

// Employee entity
model Employee {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id])
  clinics   EmployeeClinic[]
  homeClinicId String?
  homeClinic Clinic? @relation("HomeClinic", fields: [homeClinicId], references: [id])
  payRules  PayRule[]
  shifts           Shift[]
  punches          PunchRecord[]
  punchCorrections PunchCorrection[]
  changeRequestsFrom ShiftChangeRequest[] @relation("ChangeFrom")
  changeRequestsTo   ShiftChangeRequest[] @relation("ChangeTo")
  changeRequestsAsApprover ShiftChangeRequest[] @relation("ChangeApprover")
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  timeBankRecords TimeBank[]
  timeBankEntries TimeBankEntry[]
  payrollItems    PayrollItem[]
  expenseEntries  ExpenseEntry[]
  faceTemplates   FaceTemplate[]
  auditTargets    AuditLog[] @relation("AuditTarget")
  joinDate  DateTime
  leaveDate DateTime?
  resignedAt DateTime?
  status    EmployeeStatus   @default(ACTIVE)
  payConfidential Boolean @default(false) // 薪資保密 — 非 OWNER 的計糧 API 遮蔽金額
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  wageHistory   WageHistory[]
}

// Join table: Employee ↔ Clinic
model EmployeeClinic {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(true)
  joinedAt   DateTime @default(now())

  @@unique([employeeId, clinicId])
  @@index([employeeId])
  @@index([clinicId])
}

// Pay rule
model PayRule {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payType       PayType
  baseAmount    Float?
  configJson    String?  // JSON string for SQLite compat
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, isActive, effectiveFrom])
}

// Shift template — reusable shift definitions (scoped to company)
model ShiftTemplate {
  id          String   @id @default(cuid())
  name        String
  startHour   Int      // hour of day start (0-23)
  startMinute Int      // minute of day start (0-59)
  endHour     Int      // hour of day end (0-23)
  endMinute   Int      // minute of day end (0-59)
  isNightShift Boolean @default(false) // true if end crosses midnight
  shortName     String?  // 總覽顯示用簡稱（如「早」「夜」「A」），null 用 name
  shade         Int?     // 更次深淺（0 = 最深，FIXED_STEPS-1 = 最淺）。null = 沿用舊行為（按模板順序自動算）。
  isDefault   Boolean  @default(false) // system default template
  isActive    Boolean  @default(true)
  deductLunch Boolean  @default(true) // ★ 2026-08-07 false = 唔扣午飯鐘
  createdBy   String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shifts      Shift[]

  @@index([isDefault])
  @@index([companyId])
}

// Shift — links employee to a date/time at a clinic
model Shift {
  id          String      @id @default(cuid())
  employeeId  String
  clinicId    String
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  role        String?
  status      ShiftStatus @default(CONFIRMED)
  templateId  String?
  secondaryClinicId String? // ★ 調鋪：當日第二間店（時間唔確定，唔分段）
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  template    ShiftTemplate? @relation(fields: [templateId], references: [id])
  changeRequests ShiftChangeRequest[]

  @@index([employeeId, date])
  @@index([clinicId, date])
  @@index([status])
  @@index([secondaryClinicId])
  @@index([employeeId, startTime])
  @@unique([employeeId, clinicId, startTime], name: "uniq_emp_clinic_start")
}

// ── 醫生／應診者 ──────────────────────────────────────────
// 刻意同 Employee 完全分離：醫生唔打卡、唔計糧、唔放假期額度。
model Provider {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  phone     String?
  color     String?
  apricotId     String?  @unique
  apricotUserId String?  // Apricot 登入帳號 id，參考用
  companyId     String?
  company   Company? @relation(fields: [companyId], references: [id])
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts      ProviderShift[]
  clinics     ProviderClinic[]
  leaves      ProviderLeave[]
  commissions ProviderCommission[]
  reconciliations ReconciliationImport[]
  availabilities ProviderAvailability[]
  bookings       ProviderBooking[]

  @@index([companyId, isActive])
}

model ProviderShift {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  note       String?
  source     String   @default("MANUAL")
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([providerId, date, startTime])
  @@index([clinicId, date])
  @@index([providerId, date])
}

// 醫生 ↔ 診所綁定（篩選用，唔限制排更）
model ProviderClinic {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([providerId, clinicId])
  @@index([clinicId])
}

// 醫生休假 — 唔扣假期額度，只喺當值表顯示
model ProviderLeave {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startDate  DateTime // ★ HK 午夜
  endDate    DateTime
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([providerId, startDate])
  @@index([startDate, endDate])
}

// 醫生拆帳設定（append-only：改 % 就開新一條，唔准改舊記錄）
model ProviderCommission {
  id             String   @id @default(cuid())
  providerId     String
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinicId       String?
  percent        Decimal  @db.Decimal(5,2)
  basis          String   // 'GROSS' | 'NET' | 'CONSULT_ONLY'
  minGuarantee   Decimal? @db.Decimal(12,2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean  @default(true)
  note           String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([providerId, effectiveFrom])
}

// Punch record — APPEND ONLY (no UPDATE/DELETE API)
model PunchRecord {
  id          String      @id @default(cuid())
  employeeId  String
  clinicId    String
  punchTime   DateTime
  punchType   PunchType
  source      PunchSource
  tokenValid  Boolean?
  deviceInfo  String?
  notes       String?
  faceStatus    String? // PASS | FAIL | NOT_ENROLLED | SKIPPED
  faceScore     Float?
  faceLiveness  Float?
  faceFramePath String? // 只有 FAIL 有值；30 天清
  faceReviewedAt DateTime?
  faceReviewedBy String?
  faceReviewAction String? // 'CONFIRMED' | 'FLAGGED'
  faceReason     String? // 異常原因代碼

  // GPS location verification (shadow mode — observation only)
  punchLat      Float?   // 打卡當下緯度
  punchLng      Float?   // 打卡當下經度
  distanceM     Int?     // 距店距離(米)
  locationFlag  String?  // null=正常 / 'OUT_OF_RANGE' / 'NO_GPS' / 'DENIED'
  geoAccuracy   Int?     // 定位精度(米)

  createdAt   DateTime    @default(now())

  employee    Employee    @relation(fields: [employeeId], references: [id])
  clinic      Clinic      @relation(fields: [clinicId], references: [id])

  corrections PunchCorrection[] // corrections referencing this record
  void        PunchVoid?        // void record (null = active)

  @@index([employeeId, punchTime])
  @@index([clinicId, punchTime])
  @@index([punchTime])
}

// Punch void — cancels a punch record without deleting it (append-only)
model PunchVoid {
  id            String      @id @default(cuid())
  punchRecordId String      @unique
  punchRecord   PunchRecord @relation(fields: [punchRecordId], references: [id])
  voidedBy      String      // userId who voided
  reason        String      // void reason (required)
  createdAt     DateTime    @default(now())
}

// Punch correction — overlay on top of punch records (never modifies originals)
model PunchCorrection {
  id             String           @id @default(cuid())
  punchRecordId  String?          // null = no original record exists
  employeeId     String
  clinicId       String
  correctedTime  DateTime
  punchType      PunchType
  reason         String?
  requestedBy    String           // userId of requester
  approvedBy     String?          // userId of approver
  status         CorrectionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // References
  punchRecord    PunchRecord?     @relation(fields: [punchRecordId], references: [id])
  employee       Employee         @relation(fields: [employeeId], references: [id])

  @@index([employeeId, createdAt])
  @@index([status])
  @@index([status, correctedTime])
}

// QR token — short-lived dynamic tokens for punch verification
model QRToken {
  id        String   @id @default(cuid())
  clinicId  String
  token     String   @unique
  shortCode String?  // 8字元短碼，QR碼只顯示它（降密度）
  issuedAt  DateTime
  expiresAt DateTime
  used      Boolean  @default(false) // ★ DEPRECATED: 新流程用 QRTokenUsage，此欄永遠 false
  usedBy    String?  // ★ DEPRECATED
  usedAt    DateTime? // ★ DEPRECATED
  createdAt DateTime @default(now())

  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  usages    QRTokenUsage[] // ★ 每人對每碼一次的 usage 記錄

  @@index([clinicId, expiresAt])
  @@index([token])
  @@index([shortCode])
}

// QR token usage — tracks which employee used which token (per-person-per-token)
model QRTokenUsage {
  id         String   @id @default(cuid())
  tokenId    String
  employeeId String
  usedAt     DateTime @default(now())
  token      QRToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, employeeId]) // ★ 每人對每碼一次——資料庫層面原子保證
}

// Daily hash — SHA-256 fingerprint of all punch records for a clinic on a given date
model DailyHash {
  id          String   @id @default(cuid())
  clinicId    String
  date        DateTime // YYYY-01-01 format (date only)
  hash        String   // SHA-256 hex string
  recordCount Int
  createdAt   DateTime @default(now())

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, date])
}

// Audit log — APPEND ONLY
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // null for system-generated entries (e.g. ADW policy cap)
  action      String   // CREATE, UPDATE, DELETE, CORRECT, APPROVE, REJECT
  entity      String
  entityId    String
  targetEmployeeId String? // ★ 這條操作針對哪個員工
  clinicId    String?
  beforeJson  String?  // JSON string for SQLite compat
  afterJson   String?  // JSON string for SQLite compat
  notes       String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor       User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Restrict)
  targetEmployee Employee? @relation("AuditTarget", fields: [targetEmployeeId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([clinicId, createdAt])
}

// Shift change request — swap/cover/report
model ShiftChangeRequest {
  id             String       @id @default(cuid())
  shiftId        String
  shift          Shift        @relation(fields: [shiftId], references: [id])
  fromEmployeeId String
  fromEmployee   Employee     @relation("ChangeFrom", fields: [fromEmployeeId], references: [id])
  toEmployeeId   String?
  toEmployee     Employee?    @relation("ChangeTo", fields: [toEmployeeId], references: [id])
  type           ChangeType
  reason         String?
  status         ChangeStatus @default(PENDING)
  approverId     String?
  approver       Employee?    @relation("ChangeApprover", fields: [approverId], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([fromEmployeeId, status])
  @@index([toEmployeeId, status])
  @@index([status])
}

// Leave type — 年假/病假/無薪假 etc.
model LeaveType {
  id           String   @id @default(cuid())
  clinicId     String?  // null = global type
  name         String   // 年假/病假/無薪假
  systemKey    String?  @unique // 'REST_DAY' | 'ANNUAL_LEAVE' | 'OT_LEAVE' | 'SICK' | 'MATERNITY' | 'PATERNITY' | 'WORK_INJURY' | null
  isPaid       Boolean  @default(true)
  annualQuota  Float?   // 年度額度（天）
  color        String?  // UI 顏色標記
  quantity     Int?     // 預設額度（nullable = 無限制）
  isActive     Boolean  @default(true)
  cancelsBonus Boolean  @default(false) // 請此假當月取消勤工獎
  createdAt    DateTime @default(now())

  requests     LeaveRequest[]
  balances     LeaveBalance[]
}

// Leave request — employee applies for leave
model LeaveRequest {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType      @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  days        Float
  reason      String?
  status      LeaveStatus    @default(PENDING)
  approverId  String?
  approvedAt  DateTime?
  isPlanned   Boolean        @default(true) // false=臨時/當天假 → 影響勤工
  /// ★ PL 標記 —— 員工自己申請嘅休息日（純顯示，唔影響計糧／額度／時間帳戶）
  /// ⚠️ 只會喺 leaveType.systemKey === 'REST_DAY' 嘅 row 出現
  isEmployeeRequested Boolean @default(false)
  clinicId    String?        // 新增：在哪個店排的假（排班跨店過濾）
  createdAt   DateTime       @default(now())

  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@index([clinicId])
  @@index([startDate, endDate])
  @@index([employeeId, startDate])
}

// Leave balance — annual quota tracking per employee
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  /// 年份。★ 年假（ANNUAL_LEAVE）採累積制，固定用 0 代表「由入職累計」（2026-07-31 決定）；
  /// 其餘假期類型（休息日、OT補假）用曆年。
  year        Int
  entitled    Float     // 總額
  used        Float     @default(0)
  remaining   Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

// Notification — in-app notifications
model Notification {
  id             String   @id @default(cuid())
  employeeId     String
  type           String   // LEAVE_APPROVED, LEAVE_REJECTED, SHIFT_CHANGED, CORRECTION_APPROVED
  content        String
  relatedEntity  String?  // LeaveRequest, Shift, PunchCorrection
  relatedId      String?
  details        String?  // JSON array of strings — 合併通知嘅逐項明細
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([employeeId, isRead, createdAt])
}

// HK Public Holiday
model HKPublicHoliday {
  id    String   @id @default(cuid())
  date  DateTime @unique
  name  String
}

// ============================================================
// Phase 6: Payroll
// ============================================================

enum RunStatus {
  DRAFT
  FINALIZED
  EXPORTED
}

model PayrollRun {
  id           String       @id @default(cuid())
  clinicId     String?      // null = all clinics (cross-clinic)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id])
  periodMonth  DateTime     // YYYY-MM-01 format
  status       RunStatus    @default(DRAFT)
  generatedAt  DateTime     @default(now())
  notes        String?
  items        PayrollItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([clinicId, periodMonth])
  @@index([periodMonth])
}

model PayrollItem {
  id           String      @id @default(cuid())
  runId        String
  run          PayrollRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  workedHours  Float       @default(0)
  otHours      Float       @default(0)
  leaveDays    Float       @default(0)
  absentDays   Float       @default(0)
  basePay      Float       @default(0)
  otPay        Float       @default(0)
  splitPay     Float?      // 拆帳（醫生）
  deduction    Float       @default(0)
  storeBonus   Float       @default(0) // 店舖營業額獎金（手動輸入，月薪限定）
  totalPayable Float       @default(0)
  miscAmount   Float       @default(0) // 雜項報銷（從 ExpenseEntry 匯總）
  miscDetailJson String?    // JSON: [{ amount, description }]
  detailJson   String?     // JSON string for SQLite compat

  /// ★ EO 定義的「工資」總額（供 ADW 用；不含雜項報銷、不含 MPF 僱主供款）
  eoWage        Float       @default(0)
  /// ★ 該月剔除天數與款額（713 條例要求）
  excludedDays  Int         @default(0)
  excludedWage  Float       @default(0)
  /// ★ 計算時實際使用的 ADW（存檔備查）
  adwUsed       Float?
  /// ★ 產假 / 侍產假薪酬
  maternityPay  Float       @default(0)
  paternityPay  Float       @default(0)

  /// 勤工獎覆蓋：null = 自動判斷；'FORCE_ON' = 強制發放；'FORCE_OFF' = 強制取消
  attendanceBonusOverride String?

  createdAt    DateTime    @default(now())

  @@unique([runId, employeeId])
  @@index([employeeId, createdAt])
}

// ============================================================
// Expense Entry — misc reimbursement items per employee per month
// ============================================================

model ExpenseEntry {
  id           String   @id @default(cuid())
  employeeId   String
  clinicId     String?
  periodMonth  String   // "2026-07"
  amount       Float
  description  String   // 自由文字: 車費 / 買文具 / 跨店補貼
  createdBy    String   // 記錄人 userId
  createdAt    DateTime @default(now())

  // ★ 審批流程欄位
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedBy  String?
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?
  receiptUrl   String?  // 留位，第一版唔做上載

  employee     Employee @relation(fields: [employeeId], references: [id])
  clinic       Clinic?  @relation(fields: [clinicId], references: [id])

  @@index([employeeId, periodMonth])
  @@index([periodMonth, clinicId])
  @@index([status, periodMonth])
}

// ============================================================
// Consultation Revenue — actual monthly revenue per doctor per clinic
// FIX #8: Replace consultation_target (goal) with actual input
// ============================================================

model ConsultationRevenue {
  id          String   @id @default(cuid())
  employeeId  String
  clinicId    String
  month       DateTime // YYYY-MM-01 format
  amount      Float
  source      String?  // Source note (e.g., "billing system export")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, clinicId, month])
  @@index([employeeId, month])
  @@index([clinicId, month])
}

// ============================================================
// Time Bank — OT / late tracking per employee per month
// ============================================================

model TimeBank {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodMonth       DateTime // YYYY-MM-01
  otMinutes         Int      @default(0)
  lateMinutes       Int      @default(0)
  earlyLeaveMinutes Int      @default(0)
  makeupMinutes     Int      @default(0)
  /// 累計時間帳戶 = carriedFrom + (ot − makeup − netDeficit) + 換假消耗
  /// 正 = 公司欠員工；負 = 員工拖欠。同 calculateTimeBank 嘅 timeAccountMinutes 相同
  balance           Int      @default(0)
  carriedFrom       Int      @default(0) // 上月結轉
  /// 計算時的 pay rule config 指紋 + 引擎版本，不夾就重算
  cacheKey          String?
  monthEndNote      String?  // 月底結算備註
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, periodMonth])
  @@index([employeeId, periodMonth])
}

// Time Bank Entry — individual line items
model TimeBankEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  type       String   // 'OT' | 'LATE' | 'EARLY' | 'MAKEUP' | 'LEAVE_CONVERT' | 'LEAVE_SWAP_BACK'
  minutes    Int      // 正=進帳(OT/換回)，負=出帳(補鐘/換假)
  note       String?
  createdBy  String?  // 補鐘/換假記誰做的
  targetType String?  // 'LATE' | 'EARLY_LEAVE' | 'ABSENT'（MAKEUP 類型用，按類型標記避免連坐）
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

// ============================================================
// Face Verification — shadow mode, never blocks punch
// ============================================================

model FaceTemplate {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  embedding       String   // Float32[512] 的 JSON 字串
  active          Boolean  @default(true)
  enrolledAt      DateTime @default(now())
  enrolledBy      String
  consentAt       DateTime
  consentVersion  String
  approvedAt      DateTime?
  approvedBy      String?      // userId of approver
  refFrameId      String?      // face-service 上參考照的檔名 key
  @@index([employeeId, active])
}

model FaceEnrollCode {
  id          String   @id @default(cuid())
  employeeId  String
  code        String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String
}

// ============================================================
// Wage History — pre-system historical wages for ADW calculation
// ============================================================

/// 系統啟用前的歷史工資記錄（供 ADW 計算用）
/// 只在客戶上線時由 OWNER 初始化填入，之後由 PayrollItem 自動累積
model WageHistory {
  id          String   @id @default(cuid())
  employeeId  String
  periodMonth String   // "2025-08"

  /// 該月「工資」總額（EO 定義：底薪+佣金+拆帳+獎金+津貼，不含 MPF 僱主供款）
  totalWage    Float

  /// 該月「不計算在內」的天數（休息日+法定假日+年假+病假+產假等）
  excludedDays Int      @default(0)
  /// 該月「不計算在內」的款額（上述期間已支付的款項）
  excludedWage Float    @default(0)

  /// 該月曆日數（28-31，用於分母）
  calendarDays Int

  note        String?   // 資料來源備註（如「由舊系統匯入」）
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodMonth])
  @@index([employeeId, periodMonth])
}

// ============================================================
// External Credential — encrypted 3rd-party API tokens
// ============================================================

model ExternalCredential {
  id            String    @id @default(cuid())
  provider      String    @unique // 'APRICOT'
  cipherText    String    // AES-256-GCM: base64(iv || tag || ct)
  // 明文 = { accessToken, refreshToken, iat }
  refreshExpiry DateTime? // 由 Set-Cookie 個 Expires 解出
  lastOkAt      DateTime?
  lastError     String?
  callCount     Int       @default(0)
  rotationCount Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

// ============================================================
// MD-B: Cost Entry — Lab / Implant / Invisalign
// ============================================================

// Lab 主檔
model Lab {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     CostCase[]
  discounts LabMonthlyDiscount[]
}

// Universal 月度折扣
model LabMonthlyDiscount {
  id          String   @id @default(cuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  periodMonth String   // '2026-07'
  discountPct Decimal  @db.Decimal(5,2) // 8.50 = 8.5%
  note        String?
  createdBy   String
  createdAt   DateTime @default(now())

  @@unique([labId, periodMonth])
}

// 材料主檔
model MaterialItem {
  id          String   @id @default(cuid())
  name        String
  unitPrice   Decimal? @db.Decimal(12,2) // ★ nullable: 部分材料冇定價（如 collon plug）
  effectiveFrom DateTime
  effectiveTo DateTime?
  isActive    Boolean  @default(true)

  @@index([name, effectiveFrom])
}

// 成本 case
model CostCase {
  id            String   @id @default(cuid())
  providerId    String
  clinicId      String
  category      String   // 'LAB' | 'IMPLANT' | 'INVISALIGN'
  patientCode   String
  patientName   String?
  orderedAt     DateTime
  itemType      String?  // Crown / Bridge / …
  itemTypeOther String?  // Others 時嘅自由輸入
  labId         String?
  lab           Lab?     @relation(fields: [labId], references: [id])
  labOther      String?  // ★ H5: 揀 Others 時嘅自由輸入
  labOrderNo    String?
  dsaName       String?
  baseCost      Decimal? @db.Decimal(12,2) // ★ nullable = 未有價
  discountPct   Decimal? @db.Decimal(5,2) // 快照
  finalCost     Decimal? @db.Decimal(12,2) // ★ 引擎實際用呢個
  receivedAt    DateTime?
  appointmentAt DateTime?
  status        String   @default("PENDING") // PENDING | PRICED | DONE | VOID
  periodMonth   String
  lockedByRunId String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  billExtId     String? // ★ MD-F: 連連 Apricot bill
  billCode      String? // ★ MD-F: bill 編號
  billItemEleId String? // ★ MD-F: 帳單項目 eleId
  source        String   @default("BILL_LINKED") // MANUAL | BILL_LINKED

  materials CostCaseMaterial[]

  @@index([providerId, periodMonth])
  @@index([status])
  @@index([patientCode])
  @@index([billExtId])
}

// IMPLANT 材料明細
model CostCaseMaterial {
  id                String   @id @default(cuid())
  costCaseId        String
  costCase          CostCase @relation(fields: [costCaseId], references: [id], onDelete: Cascade)
  materialItemId    String
  qty               Int
  unitPriceUsed     Decimal  @db.Decimal(12,2) // ★ 快照
  isPriceOverridden Boolean  @default(false) // ★ MD-K: 用戶改過單價
  subtotal          Decimal  @db.Decimal(12,2)

  @@index([costCaseId])
}

// ============================================================
// MD-C: Apricot Data Layer — Payment / Bill Sync
// ============================================================

model ApricotPayment {
  id          String           @id @default(cuid())
  extId       String           @unique
  code        String
  clinicExtId String
  paidAt      DateTime
  totalAmt    Decimal          @db.Decimal(12,2)
  isVoid      Boolean          @default(false)
  payerType   String
  syncedAt    DateTime         @default(now())

  methods     ApricotPaymentMethod[]
  refs        ApricotPaymentRef[]

  @@index([clinicExtId, paidAt])
  @@index([paidAt])
}

model ApricotPaymentMethod {
  id         String         @id @default(cuid())
  paymentId  String
  payment    ApricotPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  methodRaw  String
  methodNorm String
  amount     Decimal        @db.Decimal(12,2)
  payType    String
  @@index([paymentId])
}

model ApricotPaymentRef {
  id        String         @id @default(cuid())
  paymentId String
  payment   ApricotPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billExtId String
  billCode  String
  amount    Decimal        @db.Decimal(12,2)
  @@index([paymentId])
  @@index([billExtId])
}

model ApricotBill {
  id            String           @id @default(cuid())
  extId         String           @unique
  code          String
  billTime      DateTime
  providerExtId String?
  clinicExtId   String
  amt           Decimal          @db.Decimal(12,2)
  ttlAmt        Decimal          @db.Decimal(12,2)
  paidAmt       Decimal          @db.Decimal(12,2)
  osAmt         Decimal          @db.Decimal(12,2)
  isVoid        Boolean          @default(false)
  isRefunded    Boolean          @default(false)
  refundRefId   String?
  syncedAt      DateTime         @default(now())

  items         ApricotBillItem[]

  @@index([providerExtId, billTime])
  @@index([clinicExtId, billTime])
}

model ApricotBillItem {
  id          String      @id @default(cuid())
  billId      String
  bill        ApricotBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  eleId       String
  feeItemCode String
  feeItemDes  String
  qty         Int
  unitPrice   Decimal    @db.Decimal(12,2)
  discPer     Decimal    @db.Decimal(5,2)
  discAmt     Decimal    @db.Decimal(12,2)
  ttlDisc     Decimal    @db.Decimal(12,2)
  amt         Decimal    @db.Decimal(12,2)
  ttlAmt      Decimal    @db.Decimal(12,2)
  reconJson   Json
  isSp2p      Boolean    @default(false) // ★ MD-K: 2人SP 偵測（remarks 含 2p1k）

  @@unique([billId, eleId])
  @@index([feeItemDes, isSp2p])
}

// ★ MD-K: 標準價目表（SP 補貼用）
model FeeItemListPrice {
  id          String   @id @default(cuid())
  feeItemCode String
  label       String
  listPrice   Decimal  @db.Decimal(12,2)
  effectiveFrom DateTime
  effectiveTo DateTime?
  createdBy   String

  @@index([feeItemCode, effectiveFrom])
}

model PaymentAllocation {
  id             String   @id @default(cuid())
  paymentExtId   String
  billExtId      String
  providerExtId  String?
  clinicExtId    String
  paidAt         DateTime
  periodMonth    String
  methodNorm     String
  amount         Decimal  @db.Decimal(12,2)
  feePercentUsed Decimal  @db.Decimal(5,3)
  netAmount      Decimal  @db.Decimal(12,2)
  countAsIncome  Boolean
  allocationMode String
  needsReview    Boolean  @default(false)
  isVoid         Boolean  @default(false) // ★ Apricot 作廢（引擎排除）
  isSuperseded   Boolean  @default(false) // ★ 重算後過時（引擎排除）
  computedAt     DateTime @default(now())

  @@unique([paymentExtId, billExtId, methodNorm])
  @@index([providerExtId, periodMonth, isVoid, isSuperseded])
  @@index([needsReview])
}

model PaymentMethodRule {
  id            String   @id @default(cuid())
  method        String
  label         String
  feePercent    Decimal  @db.Decimal(5,3) @default(0)
  countAsIncome Boolean  @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String

  @@index([method, effectiveFrom])
}

// ============================================================
// MD-D: Payout Engine — Provider commission / split settlement
// ============================================================

// ★ 獨立引擎，唔准 import payroll-engine / calculateTimeBank / prisma.employee

// 轉介記錄 — 醫生 A 轉病人去醫生 B，A 收 2%
model ProviderReferral {
  id             String   @id @default(cuid())
  fromProviderId String   // 轉介出去嘅醫生（收 2% 嗰個）
  toProviderId   String?  // 接手嘅醫生
  clinicId       String?  // ★ 診所快照（由被轉介張單解出）
  billExtId      String?  // ★ MD-U: nullable — 草稿可以冇 bill
  billCode       String?  // ★ MD-U: nullable
  billItemEleId  String?  // ★ MD-U: nullable — 草稿未揀 bill item
  itemDes        String?  // ★ MD-U: nullable
  unitPrice      Decimal? @db.Decimal(12,2) // ★ MD-U: nullable
  qty            Int      @default(1)
  refPercent     Decimal  @db.Decimal(5,2) @default(2)
  amount         Decimal? @db.Decimal(12,2) // ★ MD-U: nullable — 草稿可以冇金額
  periodMonth    String
  note           String?
  status         String?  @default("CONFIRMED") // ★ MD-U: DRAFT | CONFIRMED
  patientNote    String?  // ★ MD-U: 草稿時記低係邊個病人
  lockedByRunId  String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([fromProviderId, periodMonth])
  @@index([status])
  // ★ partial unique index 喺 migration 手寫：
  // UNIQUE(billItemEleId, fromProviderId) WHERE status='CONFIRMED' AND billItemEleId IS NOT NULL
  // Prisma schema 表達唔到，唔好用 @@unique（會擋住草稿）
  @@index([billItemEleId, fromProviderId])
}

// 2人 SP 補貼記錄 — 原價 vs 優惠價之差 × 拆帳% × 人數
model SpSubsidy {
  id           String   @id @default(cuid())
  providerId   String
  clinicId     String?  // ★ 診所快照（由 bill 解出）
  billExtId    String
  billItemEleId String
  itemDes      String   // 'SCALING & POLISHING'
  listPrice    Decimal  @db.Decimal(12,2) // 原價 580
  actualPrice  Decimal  @db.Decimal(12,2) // 優惠價 500
  headcount    Int      @default(1)
  splitPercent Decimal  @db.Decimal(5,2) // 快照：50
  amount       Decimal  @db.Decimal(12,2) // (listPrice − actualPrice) × splitPercent% × headcount
  source       String   @default("AUTO") // AUTO | MANUAL
  status       String   @default("PENDING") // PENDING | CONFIRMED | SKIPPED
  hasMarker    Boolean  @default(true) // true = 有 2P1K 標記，false = 只靠金額吻合
  confirmedBy  String?  // ★ AUTO 要人確認先入數
  needsReview  Boolean  @default(false) // ★ MD-K: 三態 review flag
  periodMonth  String
  lockedByRunId String?

  @@unique([billItemEleId])
  @@index([providerId, periodMonth])
}

// 月結單 — 鎖定後不可改；★ 粒度：醫生 × 診所 × 月
model PayoutRun {
  id             String   @id @default(cuid())
  providerId     String
  clinicId       String   // ★ 診所粒度
  periodMonth    String
  grossAmount    Decimal  @db.Decimal(12,2) // 扣手續費後
  rawAmount      Decimal  @db.Decimal(12,2) // 扣手續費前（對數用）
  labCost        Decimal  @db.Decimal(12,2)
  implantCost    Decimal  @db.Decimal(12,2)
  invisalignCost Decimal  @db.Decimal(12,2)
  profitAmount   Decimal  @db.Decimal(12,2)
  percentUsed    Decimal  @db.Decimal(5,2) // ★ 快照
  salaryAmount   Decimal  @db.Decimal(12,2)
  spSubsidy      Decimal  @db.Decimal(12,2)
  refAmount      Decimal  @db.Decimal(12,2)
  adjustAmount   Decimal  @db.Decimal(12,2) @default(0)
  totalAmount    Decimal  @db.Decimal(12,2)
  breakdownJson  Json     // 逐方式 / 逐成本項快照
  status         String   @default("DRAFT") // DRAFT | LOCKED
  lockedAt       DateTime?
  createdBy      String

  adjustments    PayoutAdjustment[]

  @@unique([providerId, clinicId, periodMonth])
  @@index([clinicId, periodMonth])
}

// 上期調整 — void 回沖 / 手動調整
model PayoutAdjustment {
  id           String   @id @default(cuid())
  runId        String?  // 落喺邊個 run（null = 未指派）
  run          PayoutRun? @relation(fields: [runId], references: [id])
  providerId   String
  clinicId     String?  // ★ 診所快照
  periodMonth  String   // 落喺邊個月
  sourceMonth  String   // 原本屬邊個月
  reason       String   // 'VOID' | 'REFUND' | 'MANUAL'
  refCode      String?  // 202607050007
  amount       Decimal  @db.Decimal(12,2) // ★ 可負
  note         String
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([providerId, periodMonth])
}

// ★ MD-Q: Apricot Sync Job — async sync progress tracking
model ApricotSyncJob {
  id              String   @id @default(cuid())
  clinicExtId     String?  // null = 全部診所
  fromDate        DateTime
  toDate          DateTime
  status          String   @default("RUNNING") // RUNNING | DONE | FAILED | CANCELLED
  totalClinics    Int      @default(1)
  doneClinics     Int      @default(0)
  paymentsSynced  Int      @default(0)
  billsChecked    Int      @default(0)
  allocRows       Int      @default(0)
  currentStep     String?  // '拉付款 第 3 頁' / '拉帳單 45/120'
  cancelRequested Boolean  @default(false)
  errorMessage    String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  createdBy       String

  @@index([status, startedAt])
}

// ★ MD-E: Monthly Payment Report Reconciliation (月報對數)
// 月報 xlsx → Apricot 官方嘅數（裁判） vs 你系統嘅數（主資料）
model ReconciliationImport {
  id           String   @id @default(cuid())
  providerId   String
  provider     Provider @relation(fields: [providerId], references: [id])
  clinicId     String?  // ★ 診所粒度
  periodMonth  String
  fileName     String
  rowCount     Int
  reportTotal  Decimal  @db.Decimal(12,2) // 報表加總
  systemTotal  Decimal  @db.Decimal(12,2) // 系統 rawAmount
  difference   Decimal  @db.Decimal(12,2)
  status       String   // MATCH | MISMATCH | ERROR
  detailJson   Json     // 逐日 / 逐方式 對比
  reportCharges Decimal? @db.Decimal(12,2) // ★ 新增：收費（Total Charges）
  chargesVsPaid Decimal? @db.Decimal(12,2) // ★ 新增：收費 − 實收
  uploadedBy   String
  uploadedAt   DateTime @default(now())

  @@index([providerId, periodMonth])
}

// ★ cw-pa: Apricot 醫生時間表（P1 資料層）
// 兩張表刻意分開：開診 = 每日一兩段（純顯示，'HH:mm' 字串）；
// 預約 = 每日十幾筆可重疊（Int 分鐘數，要 overlap 合併）。
/// Apricot 開診時段（零 PII）
model ProviderAvailability {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date        String   // 'YYYY-MM-DD'（HK）
  startTime   String   // 'HH:mm'
  endTime     String   // 'HH:mm'
  syncedAt    DateTime @default(now())

  @@unique([clinicId, providerId, date, startTime])
  @@index([clinicId, date])
}

/// Apricot 預約時段（🔴 零病人資料 —— 只有時間同狀態）
/// ⚠️ 呢張表【永遠】唔准加病人／病情／員工姓名任何欄
model ProviderBooking {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date        String   // 'YYYY-MM-DD'（HK）
  startMin    Int      // 由 00:00 起嘅分鐘數（09:30 → 570）
  endMin      Int
  status      Int      // Apricot bookingStatus；實見 0（已約）/ 4（已完成）
  syncedAt    DateTime @default(now())

  @@index([clinicId, date])
  @@index([providerId, date])
}
